{
  "name": "zdamexy/oms-web",
  "description": "OMS player website, based on osu-web",
  "type": "project",
  "homepage": "https://oms.zdamexy.work",
  "license": "AGPL-3.0",
  "support": {
    "issues": "https://github.com/ZDaMexy/oms-web/issues"
  },
  "require": {
    "ext-intl": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.0",
    "laravel/framework": "13.35.0",
    "laravel/helpers": "^1.8.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover"
    ]
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.5.0"
    },
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": ["*"]
    }
  }
}
