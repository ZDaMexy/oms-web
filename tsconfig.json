{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./resources/js",
    "experimentalDecorators": true,
    "jsx": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "es2020",
      "ESNext.Collection"
    ],
    "module": "es2020",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "strictBindCallApply": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "target": "es2015",
    "types": [
      "jquery",
      "bootstrap",
      "timeago",
      "hotwired__turbo"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "resources/js/globals.d.ts",
    "resources/js/entrypoints/app.ts",
    "resources/js/entrypoints/beatmaps.tsx",
    "resources/js/entrypoints/beatmapsets-show.tsx",
    "resources/js/entrypoints/profile-page.tsx",
    "resources/js/turbo-extended.d.ts"
  ]
}
